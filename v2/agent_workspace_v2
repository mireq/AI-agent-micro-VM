#!/usr/bin/env python3
"""Run one agent command in a persistent copy-on-write workspace."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path


class WorkspaceError(RuntimeError):
	pass


