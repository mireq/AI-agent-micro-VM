class CommandError(RuntimeError):
	def __init__(self, message: str, return_code: int = 1) -> None:
		super().__init__(message)
		self.return_code = return_code


@dataclasses.dataclass(frozen=True)
class CommandContext:
	args: argparse.Namespace
	workdir: Path
	workspace_path: Path
	config_path: Path
	agent_config_path: Path
	branch: str

	@property
	def workspace(self) -> Path:
		return self.workspace_path / 'workspaces' / self.branch

	@property
	def workspace_workdir(self) -> Path:
		return root_target(self.workspace, self.workdir)

	def with_branch(self, branch: str) -> 'CommandContext':
		return dataclasses.replace(self, branch=branch)

	@property
	def post_create_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_post_create'

	@property
	def pre_enter_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_pre_enter'

	@property
	def pre_remove_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_pre_remove'


