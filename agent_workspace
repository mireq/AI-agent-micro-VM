)


class CommandError(RuntimeError):
	def __init__(self, message: str, return_code: int = 1) -> None:
		super().__init__(message)
		self.return_code = return_code


@dataclasses.dataclass(frozen=True)
class CommandContext:
	args: argparse.Namespace
	workdir: Path
	workspace_path: Path
	config_path: Path
	agent_config_path: Path

	@property
	def post_create_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_post_create'

	@property
	def pre_enter_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_pre_enter'

	@property
	def pre_remove_script(self) -> Path:
		return self.workspace_path / 'scripts' / 'workspace_pre_remove'


@dataclasses.dataclass(frozen=True)
class MountSpec:
	flag: str
	src: Path
	dst: Path


@dataclasses.dataclass(frozen=True)
class NetForward:
	allow: str
	protocol: str
	host_port: int
	sandbox_port: int


@dataclasses.dataclass(frozen=True)
class NetworkConfig:
	isolated: bool
	verbose: bool
	forwards: list[NetForward]


def default_workdir() -> Path:
	return Path(os.environ.get('PWD', os.getcwd()))


def resolve_workdir(workdir: str) -> Path:
	return Path(workdir).expanduser().resolve(strict=False)


def agent_home() -> Path:
	return Path(os.environ.get('AGENT_HOME', '~/.agent')).expanduser()


def agent_config_path() -> Path:
	return agent_home() / 'config.toml'


def workdir_hash(workdir: Path) -> str:
	return hashlib.sha256(str(workdir).encode('utf-8')).hexdigest()


def workspace_dir(workdir: Path) -> Path:
	return agent_home() / 'workdirs' / workdir_hash(workdir)


def initialize_workspace_scripts(workspace_path: Path) -> None:
	scripts_path = workspace_path / 'scripts'
	scripts_path.mkdir(parents=True, exist_ok=True)

	for script_name in WORKSPACE_SCRIPTS:
		script_path = scripts_path / script_name
		if not script_path.exists():
			script_path.write_text(DEFAULT_SCRIPT, encoding='utf-8')
		script_path.chmod(0o755)


def read_toml_file(path: Path) -> dict:
	try:
		with path.open('rb') as file:
			return tomllib.load(file)
	except tomllib.TOMLDecodeError as exc:
		raise CommandError(f"failed to parse {path}: {exc}", return_code=2) from exc


def ensure_agent_config() -> Path:
	config_path = agent_config_path()
	config_path.parent.mkdir(parents=True, exist_ok=True)

	if not config_path.exists():
		config_path.write_text(DEFAULT_AGENT_CONFIG, encoding='utf-8')

	return config_path


def ensure_workspace_config(workdir: Path) -> tuple[Path, Path, Path]:
	agent_config = ensure_agent_config()
	workspace_path = workspace_dir(workdir)
	config_path = workspace_path / 'config.toml'
	path_file = workspace_path / '.path'
	workspace_path.mkdir(parents=True, exist_ok=True)

	if not config_path.exists():
		config_path.write_text(DEFAULT_WORKDIR_CONFIG, encoding='utf-8')
	if not path_file.exists():
		path_file.write_text(f'{workdir}\n', encoding='utf-8')

	initialize_workspace_scripts(workspace_path)

	return workspace_path, config_path, agent_config


def workspace_script_env(branch: str, workspace: Path) -> dict[str, str]:
	env = os.environ.copy()
	env['AGENT_BRANCH'] = branch
	env['AGENT_WORKSPACE_DIR'] = str(workspace)
	return env


def ensure_workspace(context: CommandContext, name: str) -> Path:
	final_dir = context.workspace_path / 'workspaces' / name
	is_new_workspace = not final_dir.exists()
	final_dir.mkdir(parents=True, exist_ok=True)

	if is_new_workspace:
		result = subprocess.run(
			[str(context.post_create_script)],
			check=False,
			env=workspace_script_env(name, final_dir),
		)
		if result.returncode != 0:
			raise CommandError(
				f"workspace_post_create failed with exit code {result.returncode}",
				return_code=result.returncode,
			)

	return final_dir


def parse_mounts(config: dict, source_name: str) -> list[MountSpec]:
	raw_mounts = config.get('mount', [])
	if raw_mounts is None:
		return []
	if not isinstance(raw_mounts, list):
		raise CommandError(f"{source_name}: 'mount' must be an array", return_code=2)

	mounts = []
	for index, raw_mount in enumerate(raw_mounts, start=1):
		if not isinstance(raw_mount, dict):
			raise CommandError(f"{source_name}: mount #{index} must be a table", return_code=2)

		flag = raw_mount.get('flag')
		src = raw_mount.get('src')
		dst = raw_mount.get('dst')
		if flag not in VALID_MOUNT_FLAGS:
			raise CommandError(f"{source_name}: mount #{index} has invalid flag: {flag!r}", return_code=2)
		if not isinstance(src, str) or not src:
			raise CommandError(f"{source_name}: mount #{index} src must be a non-empty string", return_code=2)
		if not isinstance(dst, str) or not dst.startswith('/'):
			raise CommandError(f"{source_name}: mount #{index} dst must be an absolute path", return_code=2)
		if not src.startswith('/'):
			raise CommandError(f"{source_name}: mount #{index} src must be an absolute path", return_code=2)

		mounts.append(MountSpec(flag=flag, src=Path(src).expanduser(), dst=Path(os.path.normpath(dst))))

	return mounts


def configured_mounts(context: CommandContext) -> list[MountSpec]:
	mounts = parse_mounts(read_toml_file(context.agent_config_path), str(context.agent_config_path))
	mounts.extend(parse_mounts(read_toml_file(context.config_path), str(context.config_path)))
	mounts.append(MountSpec(flag='o', src=context.workdir, dst=context.workdir))
	return remove_duplicate_mounts(mounts)


def remove_duplicate_mounts(mounts: list[MountSpec]) -> list[MountSpec]:
	seen_destinations = set()
	result = []
	for mount in mounts:
		if mount.dst in seen_destinations:
			continue
		seen_destinations.add(mount.dst)
		result.append(mount)

	return result


def parse_port(value: object, field_name: str, source_name: str, index: int) -> int:
	if not isinstance(value, int):
		raise CommandError(f"{source_name}: net #{index} {field_name} must be an integer", return_code=2)
	if value < 1 or value > 65535:
		raise CommandError(f"{source_name}: net #{index} {field_name} must be between 1 and 65535", return_code=2)

	return value


def parse_net_forwards(config: dict, source_name: str) -> list[NetForward]:
	raw_forwards = config.get('net', [])
	if raw_forwards is None:
		return []
	if not isinstance(raw_forwards, list):
		raise CommandError(f"{source_name}: 'net' must be an array", return_code=2)

	forwards = []
	for index, raw_forward in enumerate(raw_forwards, start=1):
		if not isinstance(raw_forward, dict):
			raise CommandError(f"{source_name}: net #{index} must be a table", return_code=2)

		allow = raw_forward.get('allow')
		protocol = raw_forward.get('protocol', DEFAULT_NET_PROTOCOL)
		if allow not in VALID_NET_ALLOW_RULES:
			raise CommandError(
				f"{source_name}: net #{index} allow must be host_connect_sandbox or sandbox_connect_host",
				return_code=2,
			)
		if protocol != 'tcp':
			raise CommandError(f"{source_name}: net #{index} protocol must be tcp", return_code=2)

		forwards.append(
			NetForward(
				allow=allow,
				protocol=protocol,
				host_port=parse_port(raw_forward.get('host_port'), 'host_port', source_name, index),
				sandbox_port=parse_port(raw_forward.get('sandbox_port'), 'sandbox_port', source_name, index),
			)
		)

	return forwards


def configured_network(context: CommandContext, isolated: bool = True, verbose: bool = False) -> NetworkConfig:
	config = read_toml_file(context.config_path)
	return NetworkConfig(isolated=isolated, verbose=verbose, forwards=parse_net_forwards(config, str(context.config_path)))


def stringify_env_value(value: object, key: str, source_name: str) -> str:
	if isinstance(value, bool):
		return '1' if value else '0'
	if isinstance(value, (str, int, float)):
		return str(value)

	raise CommandError(f"{source_name}: env.{key} must be a string, number, or boolean", return_code=2)


def configured_env(context: CommandContext) -> dict[str, str]:
	config = read_toml_file(context.config_path)
	source_name = str(context.config_path)
	raw_env = config.get('env', {})
	if raw_env is None:
		return {}
	if not isinstance(raw_env, dict):
		raise CommandError(f"{source_name}: 'env' must be a table", return_code=2)

	return {str(key): stringify_env_value(value, str(key), source_name) for key, value in raw_env.items()}


def root_dir(workspace: Path) -> Path:
	return workspace / 'root'


def overlay_dir(workspace: Path, mount_dst: Path) -> Path:
	relative_dst = mount_dst.relative_to('/')
	if str(relative_dst) == '.':
		relative_dst = Path('__root__')

	return workspace / 'overlay' / relative_dst


def root_target(workspace: Path, mount_dst: Path) -> Path:
	return root_dir(workspace) / mount_dst.relative_to('/')


def decode_mountinfo_path(value: str) -> str:
	return re.sub(r'\\([0-7]{3})', lambda match: chr(int(match.group(1), 8)), value)


def mountinfo_mount_path(line: str) -> Path | None:
	fields = line.split(' ', 5)
	if len(fields) < 5:
		return None

	return Path(decode_mountinfo_path(fields[4]))


def is_mounted(path: Path) -> bool:
	target = str(path)
	try:
		with Path('/proc/self/mountinfo').open('r', encoding='utf-8') as file:
			return any(str(mount_path) == target for line in file if (mount_path := mountinfo_mount_path(line)) is not None)
	except OSError:
		return False


def mounted_paths_under(path: Path) -> list[Path]:
	paths = []
	try:
		with Path('/proc/self/mountinfo').open('r', encoding='utf-8') as file:
			for line in file:
				mount_path = mountinfo_mount_path(line)
				if mount_path is not None and mount_path.is_relative_to(path):
					paths.append(mount_path)
	except OSError:
		return []

	return sorted(paths, key=lambda item: len(item.parts), reverse=True)


def unmount_path(path: Path) -> None:
	result = subprocess.run(['fusermount3', '-u', '-z', str(path)], check=False, stderr=subprocess.PIPE, text=True)
	if result.returncode != 0:
		message = result.stderr.strip() or f"failed to unmount {path}"
		raise CommandError(message, return_code=result.returncode)


def terminal_supports_color() -> bool:
	if not sys.stdout.isatty() or 'NO_COLOR' in os.environ:
		return False

	try:
		import curses

		curses.setupterm(fd=sys.stdout.fileno())
		return curses.tigetnum('colors') > 0
	except (curses.error, OSError, ValueError):
		return False


def colorize(value: str, color_code: str, enabled: bool) -> str:
	if not enabled:
		return value

	return f'\033[{color_code}m{value}\033[0m'


def color_label(value: str) -> str:
	return value


def read_origin_workdir(path: Path) -> str:
	path_file = path / '.path'
	try:
		return path_file.read_text(encoding='utf-8').rstrip('\n')
	except OSError:
		return str(path)


def iter_workspace_workdirs() -> list[tuple[str, str, list[tuple[str, bool]]]]:
	entries = []
	workdirs_path = agent_home() / 'workdirs'
	if not workdirs_path.exists():
		return entries

	for workdir_path in sorted(workdirs_path.iterdir(), key=lambda item: item.name):
		if not workdir_path.is_dir():
			continue

		origin_workdir = read_origin_workdir(workdir_path)
		workspaces_path = workdir_path / 'workspaces'
		if not workspaces_path.exists():
			continue

		branches = []
		for workspace in sorted(workspaces_path.iterdir(), key=lambda item: item.name):
			if workspace.is_dir():
				branches.append((workspace.name, bool(mounted_paths_under(workspace))))
		if branches:
			entries.append((origin_workdir, workdir_path.name, branches))

	return entries


def run_mount_command(command: list[str], description: str) -> None:
	result = subprocess.run(command, check=False, stderr=subprocess.PIPE, text=True)
	if result.returncode != 0:
		message = result.stderr.strip() or f"{description} failed with exit code {result.returncode}"
		raise CommandError(message, return_code=result.returncode)


def mount_overlay(workspace: Path, mount: MountSpec) -> None:
	src = mount.src.resolve(strict=False)
	if not src.exists():
		return
	if not src.is_dir():
		raise CommandError(f"overlay source must be a directory: {src}", return_code=2)

	target = root_target(workspace, mount.dst)
	target.mkdir(parents=True, exist_ok=True)
	if is_mounted(target):
		return

	state_dir = overlay_dir(workspace, mount.dst)
	upper_dir = state_dir / 'upper'
	work_dir = state_dir / 'work'
	upper_dir.mkdir(parents=True, exist_ok=True)
	work_dir.mkdir(parents=True, exist_ok=True)

	run_mount_command(
		[
			'fuse-overlayfs',
			'-o',
			f'lowerdir={src},upperdir={upper_dir},workdir={work_dir}',
			str(target),
		],
		f"overlay mount {src} at {target}",
	)


def prepare_workspace_root(context: CommandContext, workspace: Path) -> Path:
	root = root_dir(workspace)
	root.mkdir(parents=True, exist_ok=True)

	for mount in configured_mounts(context):
		if mount.flag == 'o':
			mount_overlay(workspace, mount)

	return root


def bwrap_mount_args(context: CommandContext, workspace: Path) -> list[str]:
	entries = []
	for mount in configured_mounts(context):
		if mount.flag == 'o':
			src = root_target(workspace, mount.dst)
			if src.exists():
				entries.append(('--bind', src, mount.dst))
		elif mount.src.exists():
			bind_flag = '--ro-bind' if mount.flag == 'r' else '--bind'
			entries.append((bind_flag, mount.src, mount.dst))

	latest_by_dst = {dst: (flag, src, dst) for flag, src, dst in entries}
	args = []
	for flag, src, dst in latest_by_dst.values():
		args.extend([flag, str(src), str(dst)])
	return args


def run_pre_enter(context: CommandContext, workspace: Path, branch: str) -> None:
	result = subprocess.run(
		[str(context.pre_enter_script), str(workspace), branch],
		check=False,
		env=workspace_script_env(branch, workspace),
	)
	if result.returncode != 0:
		raise CommandError(
			f"workspace_pre_enter failed with exit code {result.returncode}",
			return_code=result.returncode,
		)


def run_pre_remove(context: CommandContext, workspace: Path, branch: str) -> None:
	result = subprocess.run(
		[str(context.pre_remove_script)],
		check=False,
		env=workspace_script_env(branch, workspace),
	)
	if result.returncode != 0:
		raise CommandError(
			f"workspace_pre_remove failed with exit code {result.returncode}",
			return_code=result.returncode,
		)


def get_editor_command() -> list[str] | None:
	configured_editor = os.environ.get('VISUAL') or os.environ.get('EDITOR')
	if configured_editor:
		return shlex.split(configured_editor)

	return None


def open_editor(path: Path) -> int:
	command = get_editor_command()
	if command is None:
		raise CommandError("editor is not configured; set VISUAL or EDITOR", return_code=2)

	return subprocess.call([*command, str(path)])


def write_toml_file(path: Path, config: dict) -> None:
	import tomli_w

	path.write_text(tomli_w.dumps(config), encoding='utf-8')


def update_config_value(path: Path, key: str, value: str) -> None:
	config = read_toml_file(path)
	config[key] = value
	write_toml_file(path, config)
	read_toml_file(path)


def get_shell_command() -> list[str]:
	configured_shell = os.environ.get('SHELL')
	if configured_shell:
		return shlex.split(configured_shell)

	login_shell = pwd.getpwuid(os.getuid()).pw_shell
	if login_shell:
		return [login_shell]

	return ['/bin/sh']


def enter_workspace_shell(final_dir: Path, branch: str) -> int:
	command = get_shell_command()
	return enter_workspace_command(final_dir, branch, command)


def enter_workspace_command(final_dir: Path, branch: str, command: list[str]) -> int:
	if not command:
		raise CommandError("command must not be empty", return_code=2)

	env = os.environ.copy()
	env['AGENT_BRANCH'] = branch
	env['PWD'] = str(final_dir)

	os.chdir(final_dir)
	os.execvpe(command[0], command, env)
	raise AssertionError("os.execvpe returned unexpectedly")


def bwrap_command(
	context: CommandContext,
	workspace: Path,
	workdir: Path,
	branch: str,
	command: list[str],
	network: NetworkConfig,
	extra_options: list[str] | None = None,
) -> list[str]:
	if not command:
		raise CommandError("command must not be empty", return_code=2)

	args = [
		'bwrap',
		'--unshare-all',
		'--die-with-parent',
	]
	if not network.isolated:
		args.append('--share-net')
	env_args = [
		'--setenv',
		'AGENT_BRANCH',
		branch,
		'--setenv',
		'PWD',
		str(workdir),
	]
	for env_name in ('HOME', 'USER', 'LOGNAME', 'SHELL', 'PATH', 'LANG', 'LC_ALL', 'LC_CTYPE', 'TERM'):
		if env_name in os.environ:
			env_args.extend(['--setenv', env_name, os.environ[env_name]])
	for env_name, env_value in configured_env(context).items():
		env_args.extend(['--setenv', env_name, env_value])
	args.extend(
		[
			*bwrap_mount_args(context, workspace),
			'--proc',
			'/proc',
			'--dev',
			'/dev',
			'--tmpfs',
			'/tmp',
			'--clearenv',
			'--chdir',
			str(workdir),
			*env_args,
			*(extra_options or []),
			'--',
			*command,
		]
	)
	return args


def enter_bwrap_command(
	context: CommandContext,
	workspace: Path,
	workdir: Path,
	branch: str,
	command: list[str],
	network: NetworkConfig,
	extra_options: list[str] | None = None,
) -> int:
	if network.isolated:
		return run_isolated_bwrap(context, workspace, workdir, branch, command, network, extra_options=extra_options)

	os.execvpe(
		'bwrap',
		bwrap_command(context, workspace, workdir, branch, command, network, extra_options=extra_options),
		os.environ.copy(),
	)
	raise AssertionError("os.execvpe returned unexpectedly")


def read_bwrap_child_pid(status_fd: int) -> int:
	status_file = os.fdopen(status_fd, 'r', encoding='utf-8')
	with status_file:
		for line in status_file:
			status = json.loads(line)
			child_pid = status.get('child-pid')
			if child_pid is not None:
				return child_pid

	raise CommandError("bwrap did not report child pid", return_code=1)


def pasta_port_spec(forward: NetForward) -> str:
	if forward.allow == 'host_connect_sandbox':
		return f'{forward.host_port}:{forward.sandbox_port}'

	return f'{forward.sandbox_port}:{forward.host_port}'


def pasta_command(child_pid: int, network: NetworkConfig) -> list[str]:
	host_connect_sandbox = [forward for forward in network.forwards if forward.allow == 'host_connect_sandbox']
	sandbox_connect_host = [forward for forward in network.forwards if forward.allow == 'sandbox_connect_host']
	command = [
		'pasta',
		'--foreground',
		'--config-net',
		'--no-map-gw',
		'--udp-ports',
		'none',
		'--udp-ns',
		'none',
		'--host-lo-to-ns-lo',
	]
	if not network.verbose:
		command.append('--quiet')

	if host_connect_sandbox:
		for forward in host_connect_sandbox:
			command.extend(['--tcp-ports', pasta_port_spec(forward)])
	else:
		command.extend(['--tcp-ports', 'none'])

	if sandbox_connect_host:
		for forward in sandbox_connect_host:
			command.extend(['--tcp-ns', pasta_port_spec(forward)])
	else:
		command.extend(['--tcp-ns', 'none'])

	command.append(str(child_pid))
	return command


def start_pasta(child_pid: int, network: NetworkConfig) -> subprocess.Popen:
	return subprocess.Popen(
		pasta_command(child_pid, network),
		close_fds=True,
		stdout=None if network.verbose else subprocess.DEVNULL,
		stderr=None if network.verbose else subprocess.PIPE,
	)


def wait_for_pasta_start(pasta: subprocess.Popen) -> None:
	time.sleep(0.25)
	if pasta.poll() is None:
		return

	message = "pasta network setup failed"
	if pasta.stderr is not None:
		stderr = pasta.stderr.read().decode('utf-8', errors='replace').strip()
		if stderr:
			message = stderr

	raise CommandError(message, return_code=pasta.returncode or 1)


def run_isolated_bwrap(
	context: CommandContext,
	workspace: Path,
	workdir: Path,
	branch: str,
	command: list[str],
	network: NetworkConfig,
	extra_options: list[str] | None = None,
) -> int:
	status_read_fd, status_write_fd = os.pipe()
	block_read_fd, block_write_fd = os.pipe()
	bwrap_args = bwrap_command(
		context,
		workspace,
		workdir,
		branch,
		command,
		network,
		extra_options=[
			*(extra_options or []),
			'--json-status-fd',
			str(status_write_fd),
			'--block-fd',
			str(block_read_fd),
		],
	)
	bwrap = subprocess.Popen(
		bwrap_args,
		pass_fds=(status_write_fd, block_read_fd),
		close_fds=True,
	)
	os.close(status_write_fd)
	os.close(block_read_fd)

	pasta = None
	try:
		child_pid = read_bwrap_child_pid(status_read_fd)
		pasta = start_pasta(child_pid, network)
		wait_for_pasta_start(pasta)
		os.close(block_write_fd)
		block_write_fd = None
		return bwrap.wait()
	except Exception:
		bwrap.terminate()
		try:
			bwrap.wait(timeout=5)
		except subprocess.TimeoutExpired:
			bwrap.kill()
		raise
	finally:
		if block_write_fd is not None:
			os.close(block_write_fd)
		if pasta is not None:
			try:
				pasta.wait(timeout=5)
			except subprocess.TimeoutExpired:
				pasta.terminate()


def command_configure(context: CommandContext) -> int:
	if context.args.var is None and context.args.value is None:
		return open_editor(context.config_path)
	if context.args.var is None or context.args.value is None:
		raise CommandError("configure requires both var and value", return_code=2)

	update_config_value(context.config_path, context.args.var, context.args.value)
	return 0


def command_branch(context: CommandContext) -> int:
	update_config_value(context.config_path, 'branch', context.args.name)
	return 0


def configured_branch(config: dict) -> str:
	branch = config.get('branch')
	if not isinstance(branch, str) or not branch:
		raise CommandError("config field 'branch' must be a non-empty string", return_code=2)

	return branch


def current_branch(context: CommandContext) -> str:
	configured_agent_branch = os.environ.get('AGENT_BRANCH')
	if configured_agent_branch:
		return configured_agent_branch

	config = read_toml_file(context.config_path)
	return configured_branch(config)


def subagent_branch(branch: str, name: str) -> str:
	if not name:
		raise CommandError("subagent name must not be empty", return_code=2)

	return f"{branch}{WORKSPACE_SEPARATOR}{name}"


def command_cd(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = ensure_workspace(context, branch)
	prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_workspace_shell(root_target(workspace, context.workdir), branch)


def command_shell(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = ensure_workspace(context, branch)
	prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_bwrap_command(
		context,
		workspace,
		context.workdir,
		branch,
		get_shell_command(),
		configured_network(context, isolated=not context.args.shared_network, verbose=context.args.verbose),
	)


def command_subagent(context: CommandContext) -> int:
	command = context.args.exec_command
	if not command:
		raise CommandError("subagent command is required", return_code=2)

	branch = subagent_branch(current_branch(context), context.args.name)
	workspace = ensure_workspace(context, branch)
	prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_bwrap_command(context, workspace, context.workdir, branch, command, configured_network(context))


def command_umount(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = context.workspace_path / 'workspaces' / branch
	unmount_workspace(workspace)

	return 0


def confirm_remove_workspace(workspace: Path, branch: str) -> None:
	sys.stderr.write(f"Remove workspace branch \"{branch}\" at {workspace}? [y/N] ")
	sys.stderr.flush()
	answer = sys.stdin.readline().strip().lower()
	if answer not in ('y', 'yes'):
		raise CommandError("remove aborted", return_code=1)


def unmount_workspace(workspace: Path) -> None:
	for mount_path in mounted_paths_under(workspace):
		unmount_path(mount_path)


def command_rm(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = context.workspace_path / 'workspaces' / branch
	if not workspace.exists():
		raise CommandError(f"workspace does not exist: {workspace}", return_code=1)

	if not context.args.yes:
		confirm_remove_workspace(workspace, branch)

	run_pre_remove(context, workspace, branch)
	unmount_workspace(workspace)
	shutil.rmtree(workspace)
	return 0


def command_ls(context: CommandContext) -> int:
	use_color = terminal_supports_color()
	label_color = '1;97'
	path_color = '1;94'
	hash_color = '1;95'
	mounted_color = '1;92'
	unmounted_color = '1;90'
	current_color = '1;93'
	status_width = len("unmounted")
	current_marker_width = len("(*)")
	current_workdir_hash = workdir_hash(context.workdir)
	current_branch_name = current_branch(context)
	workdirs_path = agent_home() / 'workdirs'

	sys.stdout.write(f'{colorize(str(workdirs_path), label_color, use_color)}\n\n')

	workdir_entries = sorted(
		iter_workspace_workdirs(),
		key=lambda entry: (entry[1] != current_workdir_hash, entry[0]),
	)
	for origin_workdir, workdir_hash_value, branches in workdir_entries:
		visible_branches = [(branch, mounted) for branch, mounted in branches if context.args.all or mounted]
		if not visible_branches:
			continue

		is_current_workdir = workdir_hash_value == current_workdir_hash
		visible_branches = sorted(
			visible_branches,
			key=lambda entry: (not (is_current_workdir and entry[0] == current_branch_name), entry[0]),
		)
		sys.stdout.write(
			f'{colorize(workdir_hash_value, hash_color, use_color)} '
			f'{colorize(origin_workdir, path_color, use_color)}\n'
		)
		for branch, mounted in visible_branches:
			status = "mounted" if mounted else "unmounted"
			status_color = mounted_color if mounted else unmounted_color
			current_marker = "(*)" if is_current_workdir and branch == current_branch_name else ""
			sys.stdout.write(
				f'  {colorize(current_marker.ljust(current_marker_width), current_color, use_color)}  '
				f'{colorize(status.ljust(status_width), status_color, use_color)}  {branch}\n'
			)

	return 0


COMMAND_TABLE = {
	'configure': command_configure,
	'branch': command_branch,
	'cd': command_cd,
	'shell': command_shell,
	'subagent': command_subagent,
	'umount': command_umount,
	'rm': command_rm,
	'ls': command_ls,
}


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="agent_workspace",
		description="Manage per-workdir agent workspace configuration.",
	)
	parser.add_argument(
		"--workdir",
		default=str(default_workdir()),
		help="Project workdir to manage. Defaults to $PWD.",
	)

	subparsers = parser.add_subparsers(dest='command', required=True)

	configure_parser = subparsers.add_parser(
		"configure",
		help="Open or update this workdir's config.toml.",
	)
	configure_parser.add_argument("var", nargs='?', help="Config variable to set.")
	configure_parser.add_argument("value", nargs='?', help="Config value to set.")
	branch_parser = subparsers.add_parser(
		"branch",
		help="Set this workdir's branch.",
	)
	branch_parser.add_argument("name", help="Branch name to set.")
	subparsers.add_parser(
		"cd",
		help="Create or select the configured workspace and start a host shell in root/<workdir>.",
	)
	shell_parser = subparsers.add_parser(
		"shell",
		help="Create or select the configured workspace and start a bwrap shell.",
	)
	shell_parser.add_argument(
		'--shared-network',
		action='store_true',
		help="Share host networking instead of using isolated networking.",
	)
	shell_parser.add_argument(
		'--verbose',
		action='store_true',
		help="Print isolated network setup details.",
	)
	subagent_parser = subparsers.add_parser(
		"subagent",
		help="Create or select a child workspace and run a command there.",
	)
	subagent_parser.add_argument("name", help="Subagent branch suffix.")
	subagent_parser.add_argument("exec_command", nargs=argparse.REMAINDER, help="Command to run.")
	subparsers.add_parser(
		"umount",
		help="Unmount FUSE mounts in the configured workspace.",
	)
	rm_parser = subparsers.add_parser(
		"rm",
		help="Run workspace_pre_remove, unmount, and remove the current branch workspace.",
	)
	rm_parser.add_argument(
		"--yes",
		action='store_true',
		help="Remove without prompting.",
	)
	ls_parser = subparsers.add_parser(
		"ls",
		help="List mounted workspace branches.",
	)
	ls_parser.add_argument(
		"-a",
		"--all",
		action='store_true',
		help="Show unmounted workspace branches too.",
	)

	return parser


def main(argv: list[str] | None = None) -> int:
	args = build_parser().parse_args(argv)
	workdir = resolve_workdir(args.workdir)
	workspace_path, config_path, agent_config = ensure_workspace_config(workdir)
	context = CommandContext(
		args=args,
		workdir=workdir,
		workspace_path=workspace_path,
		config_path=config_path,
		agent_config_path=agent_config,
	)

	command = COMMAND_TABLE[args.command]
	return command(context)


if __name__ == '__main__':
	try:
		sys.exit(main())
	except CommandError as exc:
		sys.stderr.write(f"agent_workspace: error: {exc}\n")
		sys.exit(exc.return_code)
