DEFAULT_SCRIPT = "#!/usr/bin/env bash\n"
WORKSPACE_SEPARATOR = "__"
VALID_MOUNT_FLAGS = frozenset(("r", "w", "o"))
WORKSPACE_SCRIPTS = (
	"workspace_post_create",
	"workspace_pre_enter",
)


class CommandError(RuntimeError):
	def __init__(self, message: str, return_code: int = 1) -> None:
		super().__init__(message)
		self.return_code = return_code


@dataclasses.dataclass(frozen=True)
class CommandContext:
	args: argparse.Namespace
	workdir: Path
	workspace_path: Path
	config_path: Path
	agent_config_path: Path


@dataclasses.dataclass(frozen=True)
class MountSpec:
	flag: str
	src: Path
	dst: Path


def default_workdir() -> Path:
	return Path(os.environ.get("PWD", os.getcwd()))


def resolve_workdir(workdir: str) -> Path:
	return Path(workdir).expanduser().resolve(strict=False)


def agent_home() -> Path:
	return Path(os.environ.get("AGENT_HOME", "~/.agent")).expanduser()


def agent_config_path() -> Path:
	return agent_home() / "config.toml"


def workdir_hash(workdir: Path) -> str:
	return hashlib.sha256(str(workdir).encode("utf-8")).hexdigest()


def workspace_dir(workdir: Path) -> Path:
	return agent_home() / "workdirs" / workdir_hash(workdir)


def initialize_workspace_scripts(workspace_path: Path) -> None:
	scripts_path = workspace_path / "scripts"
	scripts_path.mkdir(parents=True, exist_ok=True)

	for script_name in WORKSPACE_SCRIPTS:
		script_path = scripts_path / script_name
		if not script_path.exists():
			script_path.write_text(DEFAULT_SCRIPT, encoding="utf-8")
		script_path.chmod(0o755)


def read_toml_file(path: Path) -> dict:
	try:
		with path.open("rb") as file:
			return tomllib.load(file)
	except tomllib.TOMLDecodeError as exc:
		raise CommandError(f"failed to parse {path}: {exc}", return_code=2) from exc


def ensure_agent_config() -> Path:
	config_path = agent_config_path()
	config_path.parent.mkdir(parents=True, exist_ok=True)

	if not config_path.exists():
		config_path.write_text(DEFAULT_AGENT_CONFIG, encoding="utf-8")

	return config_path


def ensure_workspace_config(workdir: Path) -> tuple[Path, Path, Path]:
	agent_config = ensure_agent_config()
	workspace_path = workspace_dir(workdir)
	config_path = workspace_path / "config.toml"
	workspace_path.mkdir(parents=True, exist_ok=True)

	if not config_path.exists():
		config_path.write_text(DEFAULT_WORKDIR_CONFIG, encoding="utf-8")

	initialize_workspace_scripts(workspace_path)

	return workspace_path, config_path, agent_config


def post_create_script(workspace_path: Path) -> Path:
	return workspace_path / "scripts" / "workspace_post_create"


def pre_enter_script(workspace_path: Path) -> Path:
	return workspace_path / "scripts" / "workspace_pre_enter"


def ensure_workspace(context: CommandContext, name: str) -> Path:
	final_dir = context.workspace_path / "workspaces" / name
	is_new_workspace = not final_dir.exists()
	final_dir.mkdir(parents=True, exist_ok=True)

	if is_new_workspace:
		result = subprocess.run(
			[str(post_create_script(context.workspace_path)), str(final_dir), name],
			check=False,
		)
		if result.returncode != 0:
			raise CommandError(
				f"workspace_post_create failed with exit code {result.returncode}",
				return_code=result.returncode,
			)

	return final_dir


def parse_mounts(config: dict, source_name: str) -> list[MountSpec]:
	raw_mounts = config.get("mount", [])
	if raw_mounts is None:
		return []
	if not isinstance(raw_mounts, list):
		raise CommandError(f"{source_name}: 'mount' must be an array", return_code=2)

	mounts = []
	for index, raw_mount in enumerate(raw_mounts, start=1):
		if not isinstance(raw_mount, dict):
			raise CommandError(f"{source_name}: mount #{index} must be a table", return_code=2)

		flag = raw_mount.get("flag")
		src = raw_mount.get("src")
		dst = raw_mount.get("dst")
		if flag not in VALID_MOUNT_FLAGS:
			raise CommandError(f"{source_name}: mount #{index} has invalid flag: {flag!r}", return_code=2)
		if not isinstance(src, str) or not src:
			raise CommandError(f"{source_name}: mount #{index} src must be a non-empty string", return_code=2)
		if not isinstance(dst, str) or not dst.startswith("/"):
			raise CommandError(f"{source_name}: mount #{index} dst must be an absolute path", return_code=2)
		if not src.startswith("/"):
			raise CommandError(f"{source_name}: mount #{index} src must be an absolute path", return_code=2)

		mounts.append(MountSpec(flag=flag, src=Path(src).expanduser(), dst=Path(os.path.normpath(dst))))

	return mounts


def configured_mounts(context: CommandContext) -> list[MountSpec]:
	mounts = parse_mounts(read_toml_file(context.agent_config_path), str(context.agent_config_path))
	mounts.extend(parse_mounts(read_toml_file(context.config_path), str(context.config_path)))
	mounts.append(MountSpec(flag="o", src=context.workdir, dst=context.workdir))
	return remove_duplicate_mounts(mounts)


def remove_duplicate_mounts(mounts: list[MountSpec]) -> list[MountSpec]:
	seen_destinations = set()
	result = []
	for mount in mounts:
		if mount.dst in seen_destinations:
			continue
		seen_destinations.add(mount.dst)
		result.append(mount)

	return result


def root_dir(workspace: Path) -> Path:
	return workspace / "root"


def overlay_dir(workspace: Path, mount_dst: Path) -> Path:
	relative_dst = mount_dst.relative_to("/")
	if str(relative_dst) == ".":
		relative_dst = Path("__root__")

	return workspace / "overlay" / relative_dst


def root_target(workspace: Path, mount_dst: Path) -> Path:
	return root_dir(workspace) / mount_dst.relative_to("/")


def decode_mountinfo_path(value: str) -> str:
	return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)


def is_mounted(path: Path) -> bool:
	target = str(path)
	try:
		with Path("/proc/self/mountinfo").open("r", encoding="utf-8") as file:
			return any(decode_mountinfo_path(line.split()[4]) == target for line in file)
	except OSError:
		return False


def create_mount_target(src: Path, target: Path) -> None:
	target.parent.mkdir(parents=True, exist_ok=True)
	if src.is_dir():
		target.mkdir(parents=True, exist_ok=True)
	else:
		target.touch(exist_ok=True)


def run_mount_command(command: list[str], description: str) -> None:
	result = subprocess.run(command, check=False, stderr=subprocess.PIPE, text=True)
	if result.returncode != 0:
		message = result.stderr.strip() or f"{description} failed with exit code {result.returncode}"
		raise CommandError(message, return_code=result.returncode)


def mount_bindfs(src: Path, target: Path, read_only: bool) -> None:
	if not src.exists():
		return

	create_mount_target(src, target)
	if is_mounted(target):
		return

	command = ["bindfs"]
	if read_only:
		command.append("-r")
	command.extend([str(src), str(target)])

	run_mount_command(command, f"bindfs mount {src} at {target}")


def mount_overlay(workspace: Path, mount: MountSpec) -> None:
	src = mount.src.resolve(strict=False)
	if not src.exists():
		return
	if not src.is_dir():
		raise CommandError(f"overlay source must be a directory: {src}", return_code=2)

	target = root_target(workspace, mount.dst)
	target.mkdir(parents=True, exist_ok=True)
	if is_mounted(target):
		return

	state_dir = overlay_dir(workspace, mount.dst)
	upper_dir = state_dir / "upper"
	work_dir = state_dir / "work"
	upper_dir.mkdir(parents=True, exist_ok=True)
	work_dir.mkdir(parents=True, exist_ok=True)

	run_mount_command(
		[
			"fuse-overlayfs",
			"-o",
			f"lowerdir={src},upperdir={upper_dir},workdir={work_dir}",
			str(target),
		],
		f"overlay mount {src} at {target}",
	)


def prepare_workspace_root(context: CommandContext, workspace: Path) -> Path:
	root = root_dir(workspace)
	root.mkdir(parents=True, exist_ok=True)

	for mount in configured_mounts(context):
		if mount.flag == "o":
			mount_overlay(workspace, mount)
		else:
			mount_bindfs(mount.src, root_target(workspace, mount.dst), mount.flag == "r")

	return root


def run_pre_enter(context: CommandContext, workspace: Path, branch: str) -> None:
	result = subprocess.run(
		[str(pre_enter_script(context.workspace_path)), str(workspace), branch],
		check=False,
	)
	if result.returncode != 0:
		raise CommandError(
			f"workspace_pre_enter failed with exit code {result.returncode}",
			return_code=result.returncode,
		)


def get_editor_command() -> list[str] | None:
	configured_editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
	if configured_editor:
		return shlex.split(configured_editor)

	return None


def open_editor(path: Path) -> int:
	command = get_editor_command()
	if command is None:
		raise CommandError("editor is not configured; set VISUAL or EDITOR", return_code=2)

	return subprocess.call([*command, str(path)])


def get_shell_command() -> list[str]:
	configured_shell = os.environ.get("SHELL")
	if configured_shell:
		return shlex.split(configured_shell)

	login_shell = pwd.getpwuid(os.getuid()).pw_shell
	if login_shell:
		return [login_shell]

	return ["/bin/sh"]


def enter_workspace_shell(final_dir: Path, branch: str) -> int:
	command = get_shell_command()
	return enter_workspace_command(final_dir, branch, command)


def enter_workspace_command(final_dir: Path, branch: str, command: list[str]) -> int:
	if not command:
		raise CommandError("command must not be empty", return_code=2)

	env = os.environ.copy()
	env["AGENT_BRANCH"] = branch
	env["PWD"] = str(final_dir)

	os.chdir(final_dir)
	os.execvpe(command[0], command, env)
	raise AssertionError("os.execvpe returned unexpectedly")


def enter_bwrap_command(root: Path, workdir: Path, branch: str, command: list[str]) -> int:
	if not command:
		raise CommandError("command must not be empty", return_code=2)

	os.execvpe(
		"bwrap",
		[
			"bwrap",
			"--unshare-all",
			"--share-net",
			"--die-with-parent",
			"--bind",
			str(root),
			"/",
			"--proc",
			"/proc",
			"--dev",
			"/dev",
			"--chdir",
			str(workdir),
			"--setenv",
			"AGENT_BRANCH",
			branch,
			"--setenv",
			"PWD",
			str(workdir),
			*command,
		],
		os.environ.copy(),
	)
	raise AssertionError("os.execvpe returned unexpectedly")


def command_configure(context: CommandContext) -> int:
	return open_editor(context.config_path)


def configured_branch(config: dict) -> str:
	branch = config.get("branch")
	if not isinstance(branch, str) or not branch:
		raise CommandError("config field 'branch' must be a non-empty string", return_code=2)

	return branch


def current_branch(context: CommandContext) -> str:
	configured_agent_branch = os.environ.get("AGENT_BRANCH")
	if configured_agent_branch:
		return configured_agent_branch

	config = read_toml_file(context.config_path)
	return configured_branch(config)


def subagent_branch(branch: str, name: str) -> str:
	if not name:
		raise CommandError("subagent name must not be empty", return_code=2)

	return f"{branch}{WORKSPACE_SEPARATOR}{name}"


def command_cd(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = ensure_workspace(context, branch)
	prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_workspace_shell(root_target(workspace, context.workdir), branch)


def command_shell(context: CommandContext) -> int:
	branch = current_branch(context)
	workspace = ensure_workspace(context, branch)
	root = prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_bwrap_command(root, context.workdir, branch, get_shell_command())


def command_subagent(context: CommandContext) -> int:
	command = context.args.exec_command
	if not command:
		raise CommandError("subagent command is required", return_code=2)

	branch = subagent_branch(current_branch(context), context.args.name)
	workspace = ensure_workspace(context, branch)
	root = prepare_workspace_root(context, workspace)
	run_pre_enter(context, workspace, branch)
	return enter_bwrap_command(root, context.workdir, branch, command)


COMMAND_TABLE = {
	"configure": command_configure,
	"cd": command_cd,
	"shell": command_shell,
	"subagent": command_subagent,
}


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="agent_workspace",
		description="Manage per-workdir agent workspace configuration.",
	)
	parser.add_argument(
		"--workdir",
		default=str(default_workdir()),
		help="Project workdir to manage. Defaults to $PWD.",
	)

	subparsers = parser.add_subparsers(dest="command", required=True)

	subparsers.add_parser(
		"configure",
		help="Open this workdir's config.toml in $VISUAL or $EDITOR.",
	)
	subparsers.add_parser(
		"cd",
		help="Create or select the configured workspace and start a host shell in root/<workdir>.",
	)
	subparsers.add_parser(
		"shell",
		help="Create or select the configured workspace and start a bwrap shell.",
	)
	subagent_parser = subparsers.add_parser(
		"subagent",
		help="Create or select a child workspace and run a command there.",
	)
	subagent_parser.add_argument("name", help="Subagent branch suffix.")
	subagent_parser.add_argument("exec_command", nargs=argparse.REMAINDER, help="Command to run.")

	return parser


def main(argv: list[str] | None = None) -> int:
	args = build_parser().parse_args(argv)
	workdir = resolve_workdir(args.workdir)
	workspace_path, config_path, agent_config = ensure_workspace_config(workdir)
	context = CommandContext(
		args=args,
		workdir=workdir,
		workspace_path=workspace_path,
		config_path=config_path,
		agent_config_path=agent_config,
	)

	command = COMMAND_TABLE[args.command]
	return command(context)


if __name__ == "__main__":
	try:
		sys.exit(main())
	except CommandError as exc:
		sys.stderr.write(f"agent_workspace: error: {exc}\n")
		sys.exit(exc.return_code)
