@dataclass(frozen=True)
class NetForward:
	protocol: str
	host_port: int
	sandbox_port: int


class CommandError(RuntimeError):
	def __init__(self, message: str, return_code: int = 1) -> None:
		super().__init__(message)
		self.return_code = return_code


@dataclass
class Configuration:
	mounts: list[tuple[str, Path, Path]]
	host_connect_sandbox_ports: list[NetForward]
	sandbox_connect_host_ports: list[NetForward]
	env: dict[str, str]


@dataclass
class CommandContext:
	args: argparse.Namespace
	project_path: Path
	project_workspace: Path
	legacy_workspace: bool
	sub_workspace: str | None
	configuration: Configuration
	runtime: Path
	workspace_root: Path | None = None


def check_worktree_name(name: str):
	if not re.fullmatch(r'[A-Za-z0-9._-]+', name):
		raise CommandError(f"invalid workspace name: {name!r}")


def build_bwrap_args(
	context: CommandContext,
	command: list[str],
	extra_options: list[str] | None = None,
	vm: bool = False,
):
	dev_args = []

	tun_path = Path('/dev/net/tun')
	if tun_path.exists():
		dev_args.extend(['--dev-bind', str(tun_path), str(tun_path)])

	if vm:
		kvm_path = Path('/dev/kvm')
		if not kvm_path.exists():
			raise CommandError("VM mode requires /dev/kvm", return_code=1)
		dev_args.extend(['--dev-bind', str(kvm_path), str(kvm_path)])
		fuse_path = Path('/dev/fuse')
		if fuse_path.exists():
			dev_args.extend(['--dev-bind', str(fuse_path), str(fuse_path)])

	bwrap_mount_args = []
	for mnt in context.configuration.mounts:
		flag, src, dst = mnt
		if os.environ.get(VM_ENV) == '1':
			continue
		if not src.exists():
			continue
		if flag == 'r':
			bwrap_mount_args.extend(['--ro-bind', str(src), str(dst)])
		elif flag == 'w':
			bwrap_mount_args.extend(['--bind', str(src), str(dst)])
		elif flag == 'o':
			bwrap_mount_args.extend(['--overlay-src', str(src), str(dst)])
		else:
			raise CommandError(f"invalid mount flag: {flag}", return_code=1)
	if os.environ.get(VM_ENV) == '1':
		for path in (Path('/usr'), Path('/bin'), Path('/lib'), Path('/lib64'), Path('/opt'), Path('/etc')):
			if path.exists():
				bwrap_mount_args.extend(['--ro-bind-try', str(path), str(path)])

	if context.sub_workspace is None:
		bwrap_mount_args.extend(["--bind", str(context.project_path), str(context.project_path)])
	elif context.workspace_root is not None:
		bwrap_mount_args.extend(["--bind", str(context.workspace_root), str(context.project_path)])
	else:
		bwrap_mount_args.extend([
			"--overlay-src", str(context.project_path),
			'--overlay', str(context.project_workspace / 'workspaces' / context.sub_workspace / 'upper'), str(context.project_workspace / 'workspaces' / context.sub_workspace / 'work'), str(context.project_path),
		])

	bwrap_env_args = []
	for key, value in context.configuration.env.items():
		bwrap_env_args.extend(['--setenv', key, value])
	bwrap_env_args.extend([
		'--setenv', 'AGENT_HOME', '/agent/agent-home',
		'--setenv', 'AGENT_WORKSPACE_COMMAND', '/agent/bin/agent_workspace',
		'--setenv', NESTED_ENV, '1',
	])
	if vm and not context.args.shared_network:
		bwrap_env_args.extend([
			'--setenv', 'PATH',
			f'/runtime:/agent/bin:{os.environ.get("PATH", "/usr/bin:/bin")}',
		])

	bwrap_command = ['bwrap']
	if os.environ.get(VM_ENV) == '1':
		bwrap_command = [
			'/usr/bin/setpriv',
			'--reuid', os.environ[VM_UID_ENV],
			'--regid', os.environ[VM_GID_ENV],
		]
		groups = os.environ.get(VM_GROUPS_ENV, '')
		bwrap_command.extend(['--groups', groups] if groups else ['--clear-groups'])
		bwrap_command.append('bwrap')

	args = [
		*bwrap_command,
		'--unshare-all',
		*(['--share-net'] if vm or context.args.shared_network else []),
		'--die-with-parent',
		'--proc', '/proc',
		'--dev', '/dev',
		*dev_args,
		'--tmpfs', '/tmp',
		*bwrap_mount_args,
		'--dir', '/agent',
		'--dir', '/agent/bin',
		'--bind', str(agent_home()), '/agent/agent-home',
		'--bind', str(Path('/agent/workspaces') if os.environ.get(VM_ENV) == '1' else context.project_workspace / 'workspaces'), '/agent/workspaces',
		'--ro-bind', str(Path(__file__).resolve()), '/agent/bin/agent_workspace',
		'--bind', str(context.runtime), '/runtime',
		'--clearenv',
		'--chdir',
		str(context.project_path),
		*bwrap_env_args,
		*(extra_options or []),
		'--',
		*command,
	]
	return args


def pasta_port_spec(forward: NetForward, allow: str) -> str:
	if allow == 'host_connect_sandbox':
		return f'{forward.host_port}:{forward.sandbox_port}'
	return f'{forward.sandbox_port}:{forward.host_port}'


def build_pasta_args(bwrap_command: list[str], context: CommandContext, host_loopback_to_namespace_loopback: bool = True):
	forwards = []
	configuration = context.configuration

	if configuration.host_connect_sandbox_ports:
		for forward in configuration.host_connect_sandbox_ports:
			forwards.extend(['--tcp-ports', pasta_port_spec(forward, 'host_connect_sandbox')])
	else:
		forwards.extend(['--tcp-ports', 'none'])

	if configuration.sandbox_connect_host_ports:
		for forward in configuration.sandbox_connect_host_ports:
			forwards.extend(['--tcp-ns', pasta_port_spec(forward, 'sandbox_connect_host')])
	else:
		forwards.extend(['--tcp-ns', 'none'])

	command = [
		'pasta',
		'--foreground',
		'--config-net',
		'--ipv4-only',
		'--no-map-gw',
		'--udp-ports', 'none',
		'--udp-ns', 'none',
		*(['--host-lo-to-ns-lo'] if host_loopback_to_namespace_loopback else []),
		*forwards,
		'--quiet',
		'--',
		*bwrap_command,
	]
	return command


def setpriv_command() -> list[str]:
	uid = os.getuid()
	gid = os.getgid()
	groups = list(dict.fromkeys(group for group in os.getgroups() if group != gid))
	command = ['/usr/bin/setpriv', '--reuid', str(uid), '--regid', str(gid)]
	if groups:
		command.extend(['--groups', ','.join(str(group) for group in groups)])
	else:
		command.append('--clear-groups')

	return command


def get_shell_command() -> list[str]:
	configured_shell = os.environ.get('SHELL')
	if configured_shell:
		return shlex.split(configured_shell)

	login_shell = pwd.getpwuid(os.getuid()).pw_shell
	if login_shell:
		return [login_shell]

	return ['/bin/sh']


def passt_command(context: CommandContext) -> list[str]:
	command = [
		'/usr/bin/passt', '--quiet', '--address', VM_PASST_ADDRESS,
		'--netmask', VM_PASST_NETMASK, '--gateway', VM_PASST_GATEWAY,
		'--ipv4-only', '--udp-ports', 'none',
	]
	if context.configuration.sandbox_connect_host_ports:
		command.extend(['--map-host-loopback', VM_PASST_GATEWAY])
	for forward in context.configuration.host_connect_sandbox_ports:
		command.extend(['--tcp-ports', f'127.0.0.1/{forward.host_port}:{forward.sandbox_port}'])
	if not context.configuration.host_connect_sandbox_ports:
		command.extend(['--tcp-ports', 'none'])
	return command


def write_vm_run_script(context: CommandContext, command: list[str]) -> Path:
	control = context.runtime / 'control.sock'
	control_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
	try:
		control_socket.bind(str(control))
	finally:
		control_socket.close()
	passt = context.runtime / 'passt'
	passt.write_text('#!/bin/sh\nexec ' + shlex.join(passt_command(context)) + ' "$@"\n', encoding='utf-8')
	passt.chmod(0o700)
	network_commands = [
		'#!/bin/sh',
		'ip link set eth0 up 2>/dev/null || true',
		f'ip addr add {VM_PASST_ADDRESS}/24 dev eth0 2>/dev/null || true',
		f'ip route add default via {VM_PASST_GATEWAY} dev eth0 2>/dev/null || true',
	]
	for forward in context.configuration.sandbox_connect_host_ports:
		network_commands.append(
			f'socat TCP-LISTEN:{forward.sandbox_port},bind=127.0.0.1,reuseaddr,fork '
			f'TCP:{VM_PASST_GATEWAY}:{forward.host_port} & true'
		)
	vm_environment = dict(context.configuration.env)
	vm_environment['AGENT_HOME'] = '/agent/agent-home'
	vm_environment['AGENT_WORKSPACE_COMMAND'] = '/agent/bin/agent_workspace'
	vm_environment[VM_ENV] = '1'
	vm_environment[VM_UID_ENV] = str(os.getuid())
	vm_environment[VM_GID_ENV] = str(os.getgid())
	vm_environment[VM_GROUPS_ENV] = ','.join(str(group) for group in os.getgroups())
	vm_command = ['env', '-i', *[f'{key}={value}' for key, value in vm_environment.items()], *command]
	network_commands.append(
		f'cd {shlex.quote(str(context.project_path))}'
		f' && exec {shlex.join(vm_command)}'
	)
	script_file = context.runtime / 'vm.sh'
	script_file.write_text('\n'.join(network_commands) + '\n', encoding='utf-8')
	script_file.chmod(0o700)
	return script_file


def mount_workspace_overlay(context: CommandContext) -> tuple[Path, subprocess.Popen[str], Path]:
	target = context.runtime / 'workspace'
	target.mkdir()
	workspace_base = Path('/agent/workspaces') if os.environ.get(VM_ENV) == '1' else context.project_workspace / 'workspaces'
	workspace = workspace_base / context.sub_workspace
	fuse_work = workspace / f'.fuse-work-{os.getpid()}'
	fuse_command = ['fuse-overlayfs']
	if os.environ.get(VM_ENV) == '1':
		fuse_work.mkdir(mode=0o700)
	process = subprocess.Popen(
		[
			*fuse_command,
			'-f',
			'-o',
			f'lowerdir={context.project_path},upperdir={workspace / "upper"},workdir={fuse_work}',
			str(target),
		],
		stdout=subprocess.DEVNULL,
		stderr=subprocess.PIPE,
		text=True,
	)
	for _ in range(100):
		if any(f' {target} ' in line for line in Path('/proc/self/mountinfo').read_text().splitlines()):
			return target, process, fuse_work
		if process.poll() is not None:
			message = process.stderr.read().strip() if process.stderr else ''
			raise CommandError(message or 'fuse-overlayfs failed', return_code=process.returncode or 1)
		time.sleep(0.01)
	process.terminate()
	process.wait()
	raise CommandError('fuse-overlayfs did not mount workspace', return_code=1)


def unmount_workspace_overlay(target: Path, process: subprocess.Popen[str], fuse_work: Path) -> None:
	if process.poll() is None:
		process.terminate()
		try:
			process.wait(timeout=5)
		except subprocess.TimeoutExpired:
			process.kill()
			process.wait()
	if any(f' {target} ' in line for line in Path('/proc/self/mountinfo').read_text().splitlines()):
		result = subprocess.run(
			['fusermount3', '-u', '-z', str(target)],
			check=False,
			stderr=subprocess.PIPE,
			text=True,
		)
		if result.returncode != 0:
			raise CommandError(result.stderr.strip() or f'failed to unmount {target}', return_code=result.returncode)
	shutil.rmtree(fuse_work, ignore_errors=True)


def run_command(context: CommandContext, command: list[str]):
	workspace_mount = None
	if os.environ.get(VM_ENV) == '1' and context.sub_workspace is not None:
		workspace_mount = mount_workspace_overlay(context)
		context = replace(context, workspace_root=workspace_mount[0])
	try:
		return _run_command(context, command)
	finally:
		if workspace_mount is not None:
			unmount_workspace_overlay(*workspace_mount)


def _run_command(context: CommandContext, command: list[str]):
	if context.args.vm:
		if not Path('/dev/kvm').exists():
			raise CommandError('VM mode requires /dev/kvm')
		write_vm_run_script(context, command)
		(context.runtime / 'vm.log').touch(mode=0o600)
		vm_command = [
			'chroot_vm',
			*([] if context.args.shared_network else ['--net=PASST']),
			'--log=/runtime/vm.log', '/', '/bin/sh', '/runtime/vm.sh',
		]
		wrapped_args = build_bwrap_args(context, vm_command, vm=True)
		return subprocess.call(wrapped_args)

	wrapped_args = build_bwrap_args(context, command)
	if not context.args.shared_network and os.environ.get(VM_ENV) != '1':
		wrapped_args = build_pasta_args(wrapped_args, context=context)
	return subprocess.call(wrapped_args)


def command_exec(context: CommandContext):
	if not context.args.command or context.args.command[0] != '--' or len(context.args.command) == 1:
		raise CommandError('exec requires -- COMMAND [ARGS...]', return_code=2)
	return run_command(context, context.args.command[1:])


def command_shell(context: CommandContext):
	return run_command(context, get_shell_command())


def command_configure(context: CommandContext):
	editor = os.environ.get('VISUAL') or os.environ.get('EDITOR') or 'vi'
	return subprocess.call([*shlex.split(editor), str(context.project_workspace / 'config.toml')])


COMMAND_TABLE = {
	'exec': command_exec,
	'shell': command_shell,
	'configure': command_configure,
}


def agent_home() -> Path:
	return Path(os.environ.get('AGENT_HOME', '~/.agent')).expanduser()


def workspace_slug(path: Path) -> str:
	text = str(path)
	home = str(Path.home())
	if text == home:
		text = "~"
	elif text.startswith(home + "/"):
		text = "~" + text[len(home):]
	readable = re.sub(r"[^A-Za-z0-9._~-]+", "-", text).strip("-") or "special"
	readable = readable[:120].rstrip("-") or "special"
	digest = hashlib.sha256(str(path).encode()).hexdigest()[:8]
	return f"{readable}-{digest}"


def workspace_hash(path: Path) -> str:
	return hashlib.sha256(str(path).encode('utf-8')).hexdigest()


def workspace_data_name(path: Path, legacy: bool) -> str:
	return workspace_hash(path) if legacy else workspace_slug(path)


def runtime_dir(project_path: Path, legacy_workspace: bool) -> Path:
	base = Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/agent_workspace-{os.getuid()}'))
	path = Path(tempfile.mkdtemp(prefix=f'{workspace_data_name(project_path, legacy_workspace)}-', dir=base if base.exists() else None))
	path.chmod(0o700)
	return path


def build_argument_parser():
	parser = argparse.ArgumentParser(description="Manage agent workspace")
	parser.add_argument(
		'--legacy-workspace',
		help="Use legacy workspace dir instead of new with slug.",
	)
	subparsers = parser.add_subparsers(dest='tool', required=True)
	def add_run_arguments(command_parser):
		command_parser.add_argument(
			'--shared-network',
			action='store_true',
			help="Share host networking instead of using isolated networking.",
		)
		command_parser.add_argument(
			'--vm',
			action='store_true',
			help="Run the command through chroot_vm.",
		)
		command_parser.add_argument(
			'--workspace',
			help="Separate executable sub-directory"
		)

	exec_parser = subparsers.add_parser(
		"exec",
		help="Run a command in the configured workspace with bwrap.",
	)
	add_run_arguments(exec_parser)
	exec_parser.add_argument('command', nargs=argparse.REMAINDER, help="Use -- followed by command and arguments.")
	shell_parser = subparsers.add_parser(
		"shell",
		help="Run the configured shell in the workspace with bwrap.",
	)
	add_run_arguments(shell_parser)
	subparsers.add_parser(
		"configure",
		help="Edit the project workspace configuration.",
	)
	return parser


def stringify_env_value(value: object) -> str:
	if isinstance(value, bool):
		return '1' if value else '0'
	if isinstance(value, (str, int, float)):
		return str(value)

	raise CommandError(f"Value {value} must be a string, number, or boolean", return_code=2)


def parse_configuration(agent_config: Path, project_config: Path) -> Configuration:
	mounts: list[tuple[str, Path, Path]] = []
	host_connect_sandbox_ports: list[NetForward] = []
	sandbox_connect_host_ports: list[NetForward] = []
	env: dict[str, str] = {}

	for path in [agent_config, project_config]:
		try:
			with path.open("rb") as stream:
				config = tomllib.load(stream)
		except tomllib.TOMLDecodeError as exc:
			raise CommandError(f"invalid mount config {path}: {exc}") from exc

		raw_mounts = config.get("mount", [])
		if not isinstance(raw_mounts, list):
			raise CommandError(f"invalid mount config {path}: 'mount' must be an array")
		for index, item in enumerate(raw_mounts, 1):
			if not isinstance(item, dict):
				raise CommandError(f"invalid mount config {path}: mount #{index} must be a table")
			flag = item.get("flag")
			source = item.get("src")
			destination = item.get("dst")
			if flag not in {"r", "w", "o"}:
				raise CommandError(f"invalid mount config {path}: mount #{index} has invalid flag")
			if not isinstance(source, str) or not source.startswith("/"):
				raise CommandError(f"invalid mount config {path}: mount #{index} src must be absolute")
			if not isinstance(destination, str) or not destination.startswith("/"):
				raise CommandError(f"invalid mount config {path}: mount #{index} dst must be absolute")
			mounts.append((flag, Path(source).expanduser(), Path(os.path.normpath(destination))))

		raw_nets = config.get("net", [])
		if not isinstance(raw_nets, list):
			raise CommandError(f"invalid net config {path}: 'net' must be an array")

		for index, item in enumerate(raw_nets, 1):
			if not isinstance(item, dict) or item.get("protocol", "tcp") != "tcp":
				raise CommandError(f"invalid TCP network rule #{index}")
			try:
				allow = item["allow"]
				host_port = int(item["host_port"])
				sandbox_port = int(item["sandbox_port"])
			except (KeyError, TypeError, ValueError) as exc:
				raise CommandError(f"invalid network rule #{index}") from exc
			if not 1 <= host_port <= 65535 or not 1 <= sandbox_port <= 65535:
				raise CommandError(f"invalid network port in rule #{index}")
			if allow == "host_connect_sandbox":
				host_connect_sandbox_ports.append(NetForward(protocol="tcp", host_port=host_port, sandbox_port=sandbox_port))
			elif allow == "sandbox_connect_host":
				sandbox_connect_host_ports.append(NetForward(protocol="tcp", host_port=host_port, sandbox_port=sandbox_port))
			else:
				raise CommandError(f"invalid network direction in rule #{index}")

		raw_env = config.get('env', {})
		if raw_env is not None and  not isinstance(raw_env, dict):
			raise CommandError(f"{path}: 'env' must be a table", return_code=2)

		env.update({str(key): stringify_env_value(value) for key, value in raw_env.items()})

	return Configuration(
		mounts=mounts,
		host_connect_sandbox_ports=host_connect_sandbox_ports,
		sandbox_connect_host_ports=sandbox_connect_host_ports,
		env=env,
	)


def update_env(project_path: Path, configuration: Configuration):
	configuration.env.setdefault('PWD', str(project_path))
	configuration.env.setdefault('HOME', os.environ.get('HOME', str(Path.home())))
	configuration.env.setdefault('PATH', os.environ.get('PATH', '/usr/bin:/bin'))
	configuration.env.setdefault(NESTED_ENV, '1')
	configuration.env['PATH'] = f'/agent/bin:{configuration.env['PATH']}'
	for name in ("USER", "LOGNAME", "SHELL", "LANG", "LC_ALL", "LC_CTYPE", "TERM", "COLORTERM"):
		if name in os.environ:
			configuration.env[name] = os.environ[name]


def make_context(args: argparse.Namespace) -> CommandContext:
	project_path = Path(os.getcwd()).expanduser().resolve()
	home = agent_home()
	home.mkdir(parents=True, exist_ok=True)
	agent_config = home / 'config.toml'
	if not agent_config.exists():
		agent_config.write_text(DEFAULT_AGENT_CONFIG, encoding='utf-8')
	project_workspace = home / 'workdirs' / workspace_data_name(project_path, args.legacy_workspace)
	project_workspace.mkdir(parents=True, exist_ok=True)
	project_config = project_workspace / 'config.toml'
	if not project_config.exists():
		project_config.write_text(DEFAULT_WORKSPACE_CONFIG, encoding='utf-8')
	initialize_scripts(project_workspace)
	sub_workspace = getattr(args, 'workspace', None)
	if sub_workspace is not None:
		check_worktree_name(sub_workspace)
	configuration = parse_configuration(agent_config, project_config)
	update_env(project_path, configuration)
	runtime = runtime_dir(project_path, args.legacy_workspace)
	return CommandContext(
		args=args,
		project_path=project_path,
		project_workspace=project_workspace,
		legacy_workspace=bool(args.legacy_workspace),
		sub_workspace=sub_workspace,
		configuration=configuration,
		runtime=runtime,
	)


def initialize_scripts(workspace: Path) -> None:
	workspace.joinpath('scripts').mkdir(parents=True, exist_ok=True)
	for name in SCRIPTS:
		path = workspace / 'scripts' / name
		if not path.exists():
			path.write_text('#!/usr/bin/env bash\n', encoding='utf-8')
		path.chmod(0o755)


def ensure_sub_workspace(project_workspace: Path, sub_workspace: str | None):
	workspaces = project_workspace / 'workspaces'
	workspaces.mkdir(mode=0o700, exist_ok=True)
	if sub_workspace is None:
		return
	path = workspaces / sub_workspace
	path.mkdir(mode=0o700, parents=True, exist_ok=True)
	(path / 'upper').mkdir(mode=0o700, exist_ok=True)
	(path / 'work').mkdir(mode=0o700, exist_ok=True)
	return path


def main():
	parser = build_argument_parser()
	args = parser.parse_args()
	context = make_context(args)
	try:
		ensure_sub_workspace(context.project_workspace, context.sub_workspace)
		command = COMMAND_TABLE[args.tool]
		return command(context)
	finally:
		shutil.rmtree(context.runtime, ignore_errors=True)


if __name__ == '__main__':
	try:
		sys.exit(main())
	except CommandError as exc:
		sys.stderr.write(f"agent_workspace: error: {exc}\n")
		sys.exit(exc.return_code)
